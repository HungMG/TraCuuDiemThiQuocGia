<!-- Views/MainPage.xaml -->
<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:DiemThiApp.ViewModels"
             x:Class="DiemThiApp.Views.MainPage"
             Title="Tra Cứu Điểm Thi Quốc Gia">

    <ContentPage.BindingContext>
        <vm:MainViewModel />
    </ContentPage.BindingContext>

    <VerticalStackLayout Padding="20" Spacing="16">

        <!-- Header -->
        <Label Text="🎓 TRA CỨU ĐIỂM THI QUỐC GIA"
               FontSize="20" FontAttributes="Bold"
               HorizontalOptions="Center" />

        <Label Text="Hệ thống phân tán: Node Bắc (001–500) | Node Nam (501–1000)"
               FontSize="12" TextColor="Gray"
               HorizontalOptions="Center" />

        <!-- Input -->
        <Frame BorderColor="LightGray" CornerRadius="8" Padding="4">
            <Entry x:Name="SbdEntry"
                   Placeholder="Nhập số báo danh (001–1000)"
                   Keyboard="Numeric"
                   Text="{Binding SoBaoDanh}"
                   FontSize="18" />
        </Frame>

        <!-- Nút tra cứu -->
        <Button Text="🔍 Tra Cứu"
                Command="{Binding TraCuuCommand}"
                BackgroundColor="#1565C0"
                TextColor="White"
                FontSize="16"
                CornerRadius="8"
                HeightRequest="50" />

        <!-- Loading -->
        <ActivityIndicator IsRunning="{Binding IsLoading}"
                           IsVisible="{Binding IsLoading}"
                           Color="#1565C0" />

        <!-- Kết quả -->
        <Frame BorderColor="LightBlue" CornerRadius="8" 
               BackgroundColor="#F0F8FF" Padding="16"
               IsVisible="{Binding KetQua, Converter={StaticResource NotNullConverter}}">
            <Label Text="{Binding KetQua}"
                   FontFamily="Courier New"
                   FontSize="14" />
        </Frame>

    </VerticalStackLayout>
</ContentPage>