<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="using:TraCuuDiemThiQuocGia.ViewModels"
             x:Class="TraCuuDiemThiQuocGia.MainPage"
             Shell.NavBarIsVisible="False" 
             BackgroundColor="#F5F5F5">

    <ContentPage.BindingContext>
        <vm:MainViewModel />
    </ContentPage.BindingContext>

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="0">

            <VerticalStackLayout Spacing="16" HorizontalOptions="Center" Margin="0,0,0,24">
                <Label Text="🎓" FontSize="64" HorizontalOptions="Center" />
                <Label Text="Tra cứu Điểm thi"
                       FontSize="28" FontAttributes="Bold" HorizontalOptions="Center" TextColor="#1F2937" />
                <Label Text="Hệ thống Phân tán (Miền Bắc - Miền Nam)"
                       FontSize="14" HorizontalOptions="Center" TextColor="#6B7280" />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="24" IsVisible="{Binding IsSearchVisible}">

                <VerticalStackLayout Spacing="12">
                    <Label Text="SỐ BÁO DANH" FontSize="12" FontAttributes="Bold" TextColor="#6B7280" />
                    <Frame BorderColor="#E5E7EB" CornerRadius="8" Padding="12" HasShadow="False" BackgroundColor="White">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <Entry x:Name="SbdEntry" Grid.Column="0"
                                   Placeholder="Nhập SBD (1 - 1000)..."
                                   Keyboard="Numeric"
                                   Text="{Binding SoBaoDanh}"
                                   FontSize="16" TextColor="#1F2937" PlaceholderColor="#9CA3AF"
                                   ClearButtonVisibility="WhileEditing" />
                            <Label Grid.Column="1" Text="🔍" FontSize="18" VerticalOptions="Center" />
                        </Grid>
                    </Frame>
                </VerticalStackLayout>

                <Button Text="Tra cứu kết quả"
                        Command="{Binding TraCuuCommand}"
                        BackgroundColor="#10B981" TextColor="White"
                        FontSize="16" FontAttributes="Bold" CornerRadius="8" HeightRequest="48" />

                <ActivityIndicator IsRunning="{Binding IsLoading}" IsVisible="{Binding IsLoading}"
                                   Color="#10B981" HorizontalOptions="Center" />

                <Frame BorderColor="#FCA5A5" CornerRadius="8" Padding="16" HasShadow="False" BackgroundColor="#FEF2F2"
                       IsVisible="{Binding HasError}">
                    <Label Text="{Binding ErrorMessage}"
                           TextColor="#DC2626" FontSize="14" FontAttributes="Bold"
                           HorizontalOptions="Center" HorizontalTextAlignment="Center"/>
                </Frame>

                <Frame BorderColor="#E5E7EB" CornerRadius="12" Padding="16" HasShadow="False" BackgroundColor="White">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="Hướng dẫn hệ thống:" FontSize="14" FontAttributes="Bold" TextColor="#1F2937" />
                        <VerticalStackLayout Spacing="8">
                            <StackLayout Spacing="8" Orientation="Horizontal">
                                <Label Text="•" FontSize="12" TextColor="#10B981" VerticalOptions="Start" />
                                <Label Text="Nhập SBD hợp lệ nằm trong khoảng từ 1 đến 1000."
                                       FontSize="12" TextColor="#6B7280" LineBreakMode="WordWrap" />
                            </StackLayout>
                            <StackLayout Spacing="8" Orientation="Horizontal">
                                <Label Text="•" FontSize="12" TextColor="#10B981" VerticalOptions="Start" />
                                <Label Text="SBD 1 - 500: Dữ liệu thuộc Node Miền Bắc."
                                       FontSize="12" TextColor="#6B7280" />
                            </StackLayout>
                            <StackLayout Spacing="8" Orientation="Horizontal">
                                <Label Text="•" FontSize="12" TextColor="#10B981" VerticalOptions="Start" />
                                <Label Text="SBD 501 - 1000: Dữ liệu thuộc Node Miền Nam."
                                       FontSize="12" TextColor="#6B7280" LineBreakMode="WordWrap" />
                            </StackLayout>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Frame>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="16" IsVisible="{Binding IsResultVisible}">

                <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,16">
                    <Button Grid.Column="0" Text="←" BackgroundColor="Transparent" TextColor="#6B7280"
                            FontSize="20" Padding="0" WidthRequest="40" HeightRequest="40"
                            Command="{Binding ResetCommand}" />
                    <Label Grid.Column="2" Text="KẾT QUẢ THI" FontSize="12" FontAttributes="Bold"
                           TextColor="#10B981" VerticalOptions="Center" />
                </Grid>

                <Frame BorderColor="#E5E7EB" CornerRadius="12" Padding="16" HasShadow="False" BackgroundColor="White">
                    <VerticalStackLayout Spacing="12">
                        <StackLayout Orientation="Horizontal" Spacing="12">
                            <Label Text="👤" FontSize="32" VerticalOptions="Center" />
                            <VerticalStackLayout VerticalOptions="Center">
                                <Label Text="THÍ SINH" FontSize="11" TextColor="#9CA3AF" FontAttributes="Bold" />
                                <Label Text="{Binding ThiSinh.HoTen}" FontSize="16" FontAttributes="Bold" TextColor="#1F2937" />
                            </VerticalStackLayout>
                        </StackLayout>

                        <BoxView HeightRequest="1" Color="#E5E7EB" />

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                            <VerticalStackLayout Grid.Column="0">
                                <Label Text="NGÀY SINH" FontSize="10" TextColor="#9CA3AF" FontAttributes="Bold" />
                                <Label Text="{Binding ThiSinh.NgaySinh, StringFormat='{0:dd/MM/yyyy}'}" 
                                       FontSize="14" TextColor="#1F2937" FontAttributes="Bold" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1">
                                <Label Text="HỘI ĐỒNG THI" FontSize="10" TextColor="#9CA3AF" FontAttributes="Bold" />
                                <Label Text="{Binding ThiSinh.KhuVuc}" 
                                       FontSize="14" TextColor="#10B981" FontAttributes="Bold" />
                            </VerticalStackLayout>
                        </Grid>
                    </VerticalStackLayout>
                </Frame>

                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="12">
                    <Frame Grid.Row="0" Grid.Column="0" BorderColor="#E5E7EB" CornerRadius="12" Padding="16" HasShadow="False" BackgroundColor="White">
                        <VerticalStackLayout>
                            <Label Text="Toán" FontSize="11" TextColor="#9CA3AF" FontAttributes="Bold" />
                            <Label Text="{Binding ThiSinh.DiemToan, StringFormat='{0:F2}'}" FontSize="24" FontAttributes="Bold" TextColor="#10B981" />
                        </VerticalStackLayout>
                    </Frame>
                    <Frame Grid.Row="0" Grid.Column="1" BorderColor="#E5E7EB" CornerRadius="12" Padding="16" HasShadow="False" BackgroundColor="White">
                        <VerticalStackLayout>
                            <Label Text="Ngữ văn" FontSize="11" TextColor="#9CA3AF" FontAttributes="Bold" />
                            <Label Text="{Binding ThiSinh.DiemVan, StringFormat='{0:F2}'}" FontSize="24" FontAttributes="Bold" TextColor="#10B981" />
                        </VerticalStackLayout>
                    </Frame>
                    <Frame Grid.Row="1" Grid.Column="0" BorderColor="#E5E7EB" CornerRadius="12" Padding="16" HasShadow="False" BackgroundColor="White">
                        <VerticalStackLayout>
                            <Label Text="Tiếng Anh" FontSize="11" TextColor="#9CA3AF" FontAttributes="Bold" />
                            <Label Text="{Binding ThiSinh.DiemAnh, StringFormat='{0:F2}'}" FontSize="24" FontAttributes="Bold" TextColor="#10B981" />
                        </VerticalStackLayout>
                    </Frame>
                    <Frame Grid.Row="1" Grid.Column="1" BorderColor="#E5E7EB" CornerRadius="12" Padding="16" HasShadow="False" BackgroundColor="White">
                        <VerticalStackLayout>
                            <Label Text="SỐ BÁO DANH" FontSize="11" TextColor="#9CA3AF" FontAttributes="Bold" />
                            <Label Text="{Binding ThiSinh.SoBaoDanh}" FontSize="24" TextColor="#1F2937" FontAttributes="Bold" />
                        </VerticalStackLayout>
                    </Frame>
                </Grid>

                <Button Text="Tra cứu số báo danh khác" Command="{Binding ResetCommand}"
                        BackgroundColor="White" TextColor="#10B981" FontSize="14" BorderColor="#10B981"
                        BorderWidth="1" CornerRadius="8" HeightRequest="48" Margin="0,16,0,0" />
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>